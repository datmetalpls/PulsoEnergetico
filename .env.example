# Local demo only. Copy to .env and change these before exposing beyond localhost.
DJANGO_SECRET_KEY=local-demo-key-replace-before-deployment
DEBUG=false
POSTGRES_DB=pulso
POSTGRES_USER=pulso
POSTGRES_PASSWORD=pulso-local-demo
POSTGRES_HOST=db
POSTGRES_PORT=5432
DEMO_CUENCA_PASSWORD=Cuenca-demo-2026
DEMO_PUENTE_PASSWORD=Puente-demo-2026
DEMO_OBSERVER_PASSWORD=Observador-demo-2026
# Opera Cuenca y Puente Alto (para presentar sin cambiar de usuario)
DEMO_OPERATOR_PASSWORD=Demo-2026
# Discord (opcional): URL del webhook del canal. Déjala vacía aquí y defínela solo en .env (no versionado).
# Sin valor, la app no envía nada y muestra «Simulación local».
DISCORD_WEBHOOK_URL=
